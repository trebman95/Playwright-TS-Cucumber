{
  "scripts": {
    "test": "cucumber-js --format json:report.json --exit",
    "test:e2e": "cucumber-js --tags @e2e --format json:report.json --exit",
    "test:mocked": "cucumber-js --tags @mocked --format json:report.json --exit",
    "test:api": "cucumber-js --tags @api --format json:report.json --exit",
    "test:agents": "playwright test",
    "report": "node generate-report.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.0.1",
    "@cucumber/pretty-formatter": "^1.0.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.10.3",
    "cucumber-html-reporter": "^7.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.67.0"
  }
}
